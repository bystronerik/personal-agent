{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {},
    "eval": {
      "cache": false
    },
    "eval:watch": {
      "cache": false,
      "persistent": true
    },
    "eval:models": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    },
    "agent": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    }
  }
}

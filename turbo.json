{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^generate:db", "^generate:spec", "generate:api"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "generate:spec": {
      "dependsOn": ["^generate:api"],
      "outputs": ["src/generated/openapi.yaml"]
    },
    "generate:api": {
      "outputs": ["src/generated/**"]
    },
    "generate:db": {
      "outputs": ["src/generated/**"]
    },
    "start:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate:db", "^generate:spec", "generate:api"],
      "env": [
        "DATABASE_URL",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "API_PORT",
        "CORS_ORIGIN",
        "VITE_*",
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "TELEGRAM_API_BASE"
      ]
    },
    "eval": {
      "cache": false
    },
    "eval:watch": {
      "cache": false,
      "persistent": true
    },
    "eval:models": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    },
    "agent": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    },
    "seed-schedule": {
      "cache": false,
      "dependsOn": ["^generate:db"],
      "env": ["DATABASE_URL"]
    },
    "telegram:send-test": {
      "cache": false,
      "env": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "TELEGRAM_API_BASE"]
    },
    "telegram:chat-id": {
      "cache": false,
      "env": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_API_BASE"]
    },
    "test": {
      "outputs": []
    }
  }
}

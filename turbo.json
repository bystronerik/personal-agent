{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "build": {
      "dependsOn": ["generate"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "generate": {
      "dependsOn": ["^openapi"],
      "outputs": ["src/generated/**"]
    },
    "openapi": {
      "dependsOn": ["^generate"],
      "outputs": ["src/generated/openapi.yaml"],
      "env": ["DATABASE_URL", "AUTH0_DOMAIN", "AUTH0_AUDIENCE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate", "^generate"],
      "env": [
        "DATABASE_URL",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "API_PORT",
        "CORS_ORIGIN",
        "VITE_*"
      ]
    },
    "eval": {
      "cache": false
    },
    "eval:watch": {
      "cache": false,
      "persistent": true
    },
    "eval:models": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    },
    "agent": {
      "cache": false,
      "env": ["OPENROUTER_API_KEY", "OPENROUTER_MODEL"]
    },
    "telegram:send-test": {
      "cache": false,
      "env": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "TELEGRAM_API_BASE"]
    },
    "telegram:chat-id": {
      "cache": false,
      "env": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_API_BASE"]
    },
    "test": {
      "outputs": []
    }
  }
}

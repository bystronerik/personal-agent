{
  "name": "personal-agent",
  "version": "1.0.0",
  "description": "Agentic morning/evening brief assistant",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "test": "turbo run test",
    "build": "turbo run build",
    "start": "turbo run start:dev",
    "start:dev": "turbo run start:dev",
    "db:up": "docker compose -f docker-compose.local.yml up -d",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "db:migrate": "pnpm --filter @personal-agent/db migrate",
    "db:studio": "pnpm --filter @personal-agent/db studio",
    "ingest": "pnpm --filter @personal-agent/ingest ingest",
    "eval": "turbo run eval",
    "eval:models": "turbo run eval:models",
    "generate:db": "turbo run generate:db",
    "generate:spec": "turbo run generate:spec",
    "generate:api": "turbo run generate:api",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:staged": "biome check --staged --no-errors-on-unmatched",
    "lint:staged:fix": "biome check --staged --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "husky": "^9.1.7",
    "turbo": "^2.3.3",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "personal-agent",
  "version": "1.0.0",
  "description": "Agentic morning/evening brief assistant",
  "private": true,
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @personal-agent/db migrate",
    "db:studio": "pnpm --filter @personal-agent/db studio",
    "eval": "turbo run eval",
    "eval:models": "turbo run eval:models",
    "eval:watch": "turbo run eval:watch",
    "generate": "turbo run generate",
    "agent": "turbo run agent",
    "worker": "turbo run worker",
    "seed-schedule": "turbo run seed-schedule --",
    "telegram:send-test": "turbo run telegram:send-test",
    "telegram:chat-id": "turbo run telegram:chat-id",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:staged": "biome check --staged --no-errors-on-unmatched",
    "lint:staged:fix": "biome check --staged --write --no-errors-on-unmatched",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "husky": "^9.1.7",
    "turbo": "^2.3.3",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}

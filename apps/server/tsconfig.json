{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `module: esnext` (not the base `preserve`) so @swc-node/register emits ESM
    // at runtime; `moduleResolution: bundler` keeps relative imports extensionless.
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

{
  "name": "@personal-agent/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && rolldown -c rolldown.config.ts",
    "test": "vitest run",
    "eval": "evalite run scorers.eval.ts",
    "eval:models": "evalite run model.eval",
    "eval:watch": "evalite watch",
    "agent": "tsx --env-file-if-exists=../../.env src/scripts/agent-run.ts",
    "start:dev": "node --import tsx/esm --env-file-if-exists=../../.env src/worker/main.ts",
    "seed-schedule": "tsx --env-file-if-exists=../../.env src/scripts/seed-schedule.ts",
    "probe-corpus": "tsx --env-file-if-exists=../../.env src/scripts/probe-corpus.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@openrouter/agent": "^0.7.2",
    "@openrouter/sdk": "^0.13.65",
    "@personal-agent/db": "workspace:*",
    "@personal-agent/embedding": "workspace:*",
    "@personal-agent/env": "workspace:*",
    "@personal-agent/telegram": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "croner": "^10.0.1",
    "grammy": "^1.45.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "evalite": "^0.19.0",
    "rolldown": "~1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}

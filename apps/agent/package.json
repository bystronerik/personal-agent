{
  "name": "@personal-agent/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "evalite run scorers.eval.ts",
    "eval:models": "evalite run model.eval",
    "eval:watch": "evalite watch",
    "agent": "tsx --env-file-if-exists=../../.env src/scripts/agent-run.ts",
    "worker": "node --import tsx/esm --env-file-if-exists=../../.env src/worker/main.ts",
    "seed-schedule": "tsx --env-file-if-exists=../../.env src/scripts/seed-schedule.ts"
  },
  "dependencies": {
    "@openrouter/agent": "^0.7.2",
    "@personal-agent/db": "workspace:*",
    "@personal-agent/env": "workspace:*",
    "@personal-agent/telegram": "workspace:*",
    "croner": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "evalite": "^0.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}

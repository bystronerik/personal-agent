generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  // Bare specifiers, resolved by the workspace's bundler resolution — the whole
  // repo is source-consumed (swc-node / Vite / tsx), so no runtime needs the
  // Node-style `.js` extension.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A news subject the brief should research, typed by hand in the admin portal.
model Topic {
  id        String   @id @default(uuid())
  /// Auth0 `sub` of the owner. Single-user today, scoped anyway.
  userId    String   @map("user_id")
  subject   String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, subject])
  @@map("topics")
}

{
  "name": "@personal-agent/telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc",
    "telegram:send-test": "tsx --env-file-if-exists=../../.env src/scripts/send-test.ts",
    "telegram:chat-id": "tsx --env-file-if-exists=../../.env src/scripts/chat-id.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@personal-agent/env": "workspace:*",
    "grammy": "^1.45.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}

OPENROUTER_API_KEY=

# Optional. Defaults to x-ai/grok-4.5
# Browse IDs at https://openrouter.ai/models
OPENROUTER_MODEL=

# Optional. Defaults to qwen/qwen3-embedding-8b, used by apps/ingest.
OPENROUTER_EMBEDDING_MODEL=

# Optional. Default 4000. MUST equal the width of articles.embedding — the model
# returns 4096 natively and ingest asks it to truncate. Changing this needs a
# migration and a re-embed.
OPENROUTER_EMBEDDING_DIMENSIONS=

# Optional. Default 30. How long an article stays in the corpus.
INGEST_RETENTION_DAYS=

# Issued by @BotFather in Telegram, as 123456:ABC-...
TELEGRAM_BOT_TOKEN=

# Only for `pnpm telegram:send-test`. Briefs go to users.telegram_chat_id, set on
# the account page — message your bot, then run `pnpm telegram:chat-id`
TELEGRAM_CHAT_ID=

# Optional. Defaults to https://api.telegram.org
TELEGRAM_API_BASE=

# Used by packages/db and apps/server.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# Optional. Used for docker-compose postgres setup. Defaults to agent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth0 tenant domain, as your-tenant.eu.auth0.com
AUTH0_DOMAIN=

# Identifier of the Auth0 API the admin portal calls
AUTH0_AUDIENCE=

# A machine-to-machine Auth0 app authorised for the Management API with the
# read:users scope. Not the SPA client — this one has a secret.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Optional. Default 3000
API_PORT=

# Optional. Default http://localhost:3000
CORS_ORIGIN=

# Optional. Default http://localhost:3001. Where the API answers publicly — the
# host apps/agent points unsubscribe links at. Not CORS_ORIGIN, which is the portal.
PUBLIC_API_URL=

# Signs unsubscribe links. apps/server and apps/agent must be given the same
# value. Generate with `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=

# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Sender of the brief. Must be on a domain verified in Resend.
EMAIL_FROM=Personal Agent <brief@example.com>

# VITE_-prefixed values are inlined into the browser bundle. Only public Auth0
# SPA identifiers belong here — a PKCE client has no secret.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_API_URL=http://localhost:3001
